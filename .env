# .env
# DokPDF Environment Configuration

# Application
APP_NAME=DokPDF
APP_VERSION=1.0.0
FLASK_ENV=production
SECRET_KEY=dokpdf-secret-key-change-in-production

# File Limits
MAX_FILE_SIZE=52428800
MAX_UPLOAD_SIZE=150M

# Timezone
TZ=Asia/Jakarta

# API
API_HOST=0.0.0.0
API_PORT=5000

# Turnstile (Cloudflare)
TURNSTILE_SITE_KEY=0x4AAAAAAB11NQJN0zyzKFAL
TURNSTILE_SECRET_KEY=your-turnstile-secret-key

# Database (optional)
# DATABASE_URL=sqlite:///dokpdf.db